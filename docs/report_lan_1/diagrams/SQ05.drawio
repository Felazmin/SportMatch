<mxfile host="app.diagrams.net" type="device"><diagram id="SQ05" name="Phân quyền và thao tác nhân viên"><mxGraphModel dx="1160" dy="1058" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1160" pageHeight="1058" math="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n2" value="Phân quyền và thao tác nhân viên" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;text;strokeColor=none;fillColor=none;spacing=2;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="28" y="14" width="1104" height="42" as="geometry" /></mxCell><mxCell id="n3" value="Hiện trạng: gọi nội bộ Flutter, không có API server. Mũi tên đứt: trả kết quả hoặc lỗi." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;text;strokeColor=none;fillColor=none;spacing=2;align=left;fontColor=#52635c;" vertex="1" parent="1"><mxGeometry x="28" y="60" width="1104" height="48" as="geometry" /></mxCell><mxCell id="n4" value="Chủ sân / NV" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="15.0" y="115" width="170" height="52" as="geometry" /></mxCell><mxCell id="n5" value="UI nhân viên" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="335.0" y="115" width="170" height="52" as="geometry" /></mxCell><mxCell id="n6" value="DemoSession" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="655.0" y="115" width="170" height="52" as="geometry" /></mxCell><mxCell id="n7" value="SessionStore" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="975.0" y="115" width="170" height="52" as="geometry" /></mxCell><mxCell id="n8" value="alt [kiểm tra hợp lệ]" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=12;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="175" width="1120" height="863" as="geometry" /></mxCell><mxCell id="n9" value="1. Chọn quyền/cơ sở và mật khẩu xác nhận" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;text;strokeColor=none;fillColor=none;spacing=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110.0" y="195" width="300.0" height="38" as="geometry" /></mxCell><mxCell id="n10" value="2. configureEmployeeAccess&#10;(expectedRevision)" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;text;strokeColor=none;fillColor=none;spacing=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="430.0" y="252" width="300.0" height="38" as="geometry" /></mxCell><mxCell id="n11" value="3. Kiểm tra managerPassword, schedule phụ thuộc, scope" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;text;strokeColor=none;fillColor=none;spacing=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="667.5" y="309" width="210" height="38" as="geometry" /></mxCell><mxCell id="n12" value="4. Lưu access và revision mới" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;text;strokeColor=none;fillColor=none;spacing=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="750.0" y="366" width="300.0" height="38" as="geometry" /></mxCell><mxCel