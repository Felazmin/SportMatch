<mxfile host="app.diagrams.net" type="device"><diagram id="SQ06" name="Đăng ký và thanh toán giải đấu"><mxGraphModel dx="1160" dy="1001" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1160" pageHeight="1001" math="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n2" value="Đăng ký và thanh toán giải đấu" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;text;strokeColor=none;fillColor=none;spacing=2;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="28" y="14" width="1104" height="42" as="geometry" /></mxCell><mxCell id="n3" value="Hiện trạng: gọi nội bộ Flutter, không có API server. Mũi tên đứt: trả kết quả hoặc lỗi." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;text;strokeColor=none;fillColor=none;spacing=2;align=left;fontColor=#52635c;" vertex="1" parent="1"><mxGeometry x="28" y="60" width="1104" height="48" as="geometry" /></mxCell><mxCell id="n4" value="Khách hàng" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="15.0" y="115" width="170" height="52" as="geometry" /></mxCell><mxCell id="n5" value="UI giải đấu" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="335.0" y="115" width="170" height="52" as="geometry" /></mxCell><mxCell id="n6" value="DemoSession" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="655.0" y="115" width="170" height="52" as="geometry" /></mxCell><mxCell id="n7" value="SessionStore" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="975.0" y="115" width="170" height="52" as="geometry" /></mxCell><mxCell id="n8" value="alt [kiểm tra hợp lệ]" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=12;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="175" width="1120" height="806" as="geometry" /></mxCell><mxCell id="n9" value="1. Xem giải, nhập người đăng ký và đồng đội" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;text;strokeColor=none;fillColor=none;spacing=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110.0" y="195" width="300.0" height="38" as="geometry" /></mxCell><mxCell id="n10" value="2. joinEvent: thời gian, capacity, nhóm, vé" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;text;strokeColor=none;fillColor=none;spacing=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="430.0" y="252" width="300.0" height="38" as="geometry" /></mxCell><mxCell id="n11" value="3. Vé với eventSnapshot hoặc lỗi" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;text;strokeColor=none;fillColor=none;spacing=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="430.0" y="309" width="300.0" height="38" as="geometry" /></mxCell><mxCell id="n12" value="4. Chọn phương thức và bấm thanh toán" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;text;strokeColor=none;fillColor=none;spacing=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110.0" y="366" width="300.0" height="38" as="geometry" /></mxCell><mxCell id="n13" value="5. payTournamentDemo(ticket, method)" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;text;strokeColor=none;fillColor=none;spacing=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="430.0" y="423" width="300.0" height="38" as="geometry" /></mxCell><mxCell id="n14" value="6. Ghi approved; simulatedGateway=true" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;text;strokeColor=none;fillColor=none;spacing=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="667.5" y="480" width="210" height="38" as="geometry" /></mxCell><mxCell id="n15" value="7. Lưu vé, thanh toán và trạng thái" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;text;strokeColor=none;fillColor=none;spacing=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="750.0" y="537" width="300.0" height="38" as="geometry" /></mxCell><mxCell id="n16" value="8. Mã đăng ký, xác nhận suất" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;text;strokeColor=none;fillColor=none;spacing=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="430.0" y="594" width="300.0" height="38" as="geometry" /></mxCell><mxCell id="n17" value="9. Xem vé và lịch đấu" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;text;strokeColor=none;fillColor=none;spacing=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110.0" y="651" width="300.0" height="38" as="geometry" /></mxCell><mxCell id="n18" value="10. Đọc vé/fixtures theo tài khoản" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;text;strokeColor=none;fillColor=none;spacing=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="430.0" y="708" width="300.0" height="38" as="geometry" /></mxCell><mxCell id="n19" value="11. Trả thông tin thuộc phạm vi" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;text;strokeColor=none;fillColor=none;spacing=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="430.0" y="765" width="300.0" height="38" as="geometry" /></mxCell><mxCell id="n20" value="else [có lỗi hoặc không đủ điều kiện tại bước tương ứng]" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=12;fontColor=#172b25;fillColor=#ffffff;strokeColor=#60756d;rounded=0;spacing=10;text;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="30" y="850" width="1080" height="26" as="geometry" /></mxCell><mxCell id="n21" value="Đây là thanh toán mô phỏng, không có PSP, webhook hoặc email thật." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;fontColor=#172b25;fillColor=#fff5df;strokeColor=#60756d;rounded=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="882" width="1080" height="42" as="geometry" /></mxCell><mxCell id="n22" value="Điều kiện: hết chỗ / ngưng / hết hạn / vé không hợp lệ → không báo thành công." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;fontColor=#172b25;fillColor=#fff5df;strokeColor=#60756d;rounded=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="929" width="1080" height="42" as="geometry" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Arial;fontSize=12;strokeColor=#527367;labelBackgroundColor=#ffffff;endArrow=none;endFill=0;jumpStyle=arc;jumpSize=9;dashed=1;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100.0" y="167" as="sourcePoint" /><mxPoint x="100.0" y="847" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=